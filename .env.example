# Copy to .env.local. Values come from `npx supabase status` (local) or the
# Supabase dashboard (hosted). Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Not used in Sprint 001. Reserved for the Sprint 002 analysis worker, which
# runs server-side only. Do not expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
