# Copy to .env.local. Values come from `npx supabase status` (local) or the
# Supabase dashboard (hosted). Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI review worker only (`npm run worker`). Server-side, never in the Next.js
# app or the browser. Set these in the worker's own environment.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
